{
  "name": "npc-life-simulator",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "NPC-Life Simulator - Living World: eine vollstaendig simulierte Stadt mit 1.000+ autonomen NPCs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "simtest": "esbuild src/dev/headless.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/headless.mjs --log-level=warning && node node_modules/.cache/headless.mjs",
    "e2e": "node scripts/e2e.mjs",
    "probe": "esbuild src/dev/probe.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/probe.mjs --log-level=warning && node node_modules/.cache/probe.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
